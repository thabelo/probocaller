# ── Database ────────────────────────────────────────────────
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=probocaller

# ── Auth ────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_128_char_hex_secret
JWT_REFRESH_SECRET=replace_with_another_128_char_hex_secret

# ── Suppression / unlist (POPIA/GDPR opt-out) ───────────────
# Secret pepper for the keyed HMAC of unlisted phone numbers. MUST be set in
# production and kept OUT of the database — a DB leak alone can't then be brute-
# forced back to numbers. Generate with the same command as the JWT secrets.
SUPPRESSION_PEPPER=replace_with_a_long_random_secret

# ── Server ──────────────────────────────────────────────────
PORT=3000
# NODE_ENV drives the environment split (see src/common/config/app-config.ts):
#   development → docs ON,  log level debug
#   staging     → docs ON,  log level debug, migrations auto-run
#   production  → docs OFF (unless ENABLE_DOCS=true), log level info,
#                 migrations auto-run, placeholder/weak secrets rejected at boot
# Aliases accepted: prod→production, stage→staging.
NODE_ENV=development
# Optional per-environment overrides:
# ENABLE_DOCS=true
# LOG_LEVEL=info   # debug | info | warn | error

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── OpenAI (AI Assistant call screening — Whisper + chat summary) ──
# Leave blank to use the stub transcriber; set a real key to enable Whisper.
OPENAI_API_KEY=

# ── Referral programme ──────────────────────────────────────
# Lifetime referral commission rate. Whenever a REFERRED user EARNS (call,
# pay-to-contact settle, data sale), their referrer earns this fraction of that
# earning as an EXTRA, platform-funded credit — the referee always keeps 100%.
# Clamped to [0, 1); invalid values fall back to the default (0.03 = 3%).
# A value of 0 is a kill-switch: no commission is paid, no ledger rows written,
# so the programme can be disabled without a deploy.
REFERRAL_COMMISSION_RATE=0.03

# ── Data retention ──────────────────────────────────────────
# Records older than these windows are purged daily (and via POST /admin/retention/purge).
CALL_LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=730

# Google Places (optional) — external caller-ID fallback for numbers not yet in
# our own directory. Resolves a public *business* name via "Find Place from phone
# number". Leave blank to disable (lookups still work, just without name
# enrichment). Server-side only; never exposed to clients. The returned name is
# shown live but never persisted (Google Maps Platform ToS forbids caching it).
GOOGLE_MAPS_API_KEY=
# Flat USD cost per Find Place request, for the admin billing dashboard.
GOOGLE_PLACES_COST_USD=0.017
